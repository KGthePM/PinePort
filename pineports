async function refresh(){
 const h=document.documentElement;h.classList.add('io');setTimeout(()=>h.classList.remove('io'),200);
 const r=await fetch('/api/services');const d=await r.json();
 const st=d.stats;
 document.querySelector('#stats').innerHTML=
  `<span>CPU <b>${st.cpu_pct}%</b>${meter(st.cpu_pct)}</span>`+
  `<span>RAM <b>${st.ram_used}/${st.ram_total}G</b> <b>${st.ram_pct}%</b>${meter(st.ram_pct)}</span>`+
  `<span>DISK <b>${st.disk_pct}%</b>${meter(st.disk_pct)}</span>`+
  `<span>free <b>${st.disk_free}G</b></span>`+
  `<span>load <b>${st.load1}</b></span><span>up <b>${st.uptime}</b></span>`+
  `<span>NET in <b>${rate(st.net_down)}</b> out <b>${rate(st.net_up)}</b></span>`+
  `<span>conns <b>${st.conns}</b></span>`;
 const tb=document.querySelector('#t tbody'),was=cells,fx=h.dataset.fx;
 /* tetromino: remember each row's pid and height so a vanished one can clear */
 const old=fx==='tet'?[...tb.rows].map(r=>[r.dataset.pid,r.offsetHeight]):[];
 tb.innerHTML='';cells={};let fresh=0;
 d.services.forEach(s=>{
  const tr=document.createElement('tr');tr.dataset.pid=s.pid;
  if(fx==='tet'&&!was[s.pid+'.0']){tr.className='drop';tr.style.setProperty('--r',fresh++)}
  const sys=own.some(o=>s.name.includes(o));
  const ports=s.ports.map(p=>{
   const t=(s.links||[]).includes(p)?`<a href="http://${location.hostname}:${p}/" target=_blank rel=noopener>${p}</a>`:p;
   return s.new&&s.new.includes(p)?t+'<span class="badge">new</span>':t}).join(', ');
  tr.innerHTML=`<td title="${esc('pid '+s.pid+(s.cmd?'\\n'+s.cmd:''))}">${esc(s.name)}</td><td class=mem>${s.rss?s.rss.toFixed(0)+' MB':'-'}</td>
   <td>${ports}</td><td>${sys?'':'<button data-p="'+s.ports[0]+'" data-pid="'+s.pid+'" data-n="'+esc(s.name+' (pid '+s.pid+')')+'">kill</button>'}</td>`;
  const flap=fx==='flap';
  [...tr.cells].forEach((td,i)=>{const k=s.pid+'.'+i,o=was[k]||{t:'',h:''},h=td.innerHTML;
   cells[k]={t:td.textContent,h};
   if(flap&&o.t!==cells[k].t)td.insertAdjacentHTML('beforeend',
    `<div class="fl fl-ob"><span>${o.h}</span></div><div class="fl fl-ot"><span>${o.h}</span></div><div class="fl fl-nb"><span>${h}</span></div>`)});
  tb.appendChild(tr);});
 const live=new Set(d.services.map(s=>String(s.pid)));
 old.forEach(([pid,ht],i)=>{if(!pid||live.has(pid))return;
