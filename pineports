# Effect skins, turned on by a theme's _fx key (html[data-fx=...]). CSS only, so
# nothing runs between polls; animations play only when the skin appears or a
# poll redraws the rows.
# A skin that paints <html> with a gradient also needs a solid background-color:
# iOS Safari fills the status bar and landscape notch insets with that color only.
# Retro CRT matches Needle's desklet theme: beige bezel, green phosphor screen,
# square block gauges, and a badge + power LED that blinks on each refresh.
FX_CSS = """html[data-fx=crt]{background:#d8d0b8 linear-gradient(#d8d0b8,#b9b096);padding:.8rem .8rem 0}
html[data-fx=crt] body{position:relative;box-sizing:border-box;min-height:calc(100vh - 4rem);
margin:0 auto 3.2rem;padding:1rem 1.1rem;background:linear-gradient(#0b1a0f,#050c07);
border:3px solid #2e2b24;border-radius:14px;box-shadow:inset 0 0 3rem rgba(0,0,0,.75),0 0 0 2px #8a8270;
text-shadow:0 0 4px rgba(57,255,106,.55);animation:crt-on .6s ease-out}
html[data-fx=crt] body::after{content:'';position:absolute;inset:0;border-radius:11px;pointer-events:none;
z-index:1;background:repeating-linear-gradient(transparent 0 2px,rgba(0,0,0,.2) 2px 3px)}
html[data-fx=crt] body::before{content:'PINEPORTS';position:absolute;left:.4rem;right:.4rem;bottom:-2.2rem;
color:#5b5444;font-size:.7rem;letter-spacing:.3em;text-shadow:none;line-height:1rem;
background:radial-gradient(circle at calc(100% - .4rem) 50%,#2f8f45 .22rem,transparent .28rem)}
html[data-fx=crt].io body::before{background:radial-gradient(circle at calc(100% - .4rem) 50%,#7dff9e .22rem,rgba(57,255,106,.35) .32rem,transparent .5rem)}
html[data-fx=crt] button,html[data-fx=crt] input{position:relative;z-index:2;border-radius:0;text-shadow:none}
html[data-fx=crt] .badge,html[data-fx=crt] #stats,html[data-fx=crt] .meter,html[data-fx=crt] .meter i{border-radius:0}
html[data-fx=crt] .meter i{color:var(--accent);background:repeating-linear-gradient(90deg,currentColor 0 .3rem,transparent .3rem .4rem)}
html[data-fx=crt] .warn i{color:var(--warn)}html[data-fx=crt] .crit i{color:var(--kill)}
@keyframes crt-on{0%{transform:scale(.6,.004);filter:brightness(3)}35%{transform:scale(1,.004)}
70%{transform:none;filter:brightness(1.6)}100%{transform:none;filter:none}}
/* Departures: a split-flap airport board. Yellow wayfinding header, every cell
   is a flap with a hinge line. When a cell's text changes, refresh() lays three
   .fl copies over it: old bottom half (static), old top half (falls away about
   the hinge), new bottom half (lands over the old one). Cascades diagonally on
   first load. Only the overlays move, never the cell (iOS mangles transforms on
   table cells). Fixed table layout so no font can push columns off the board.
   Columns/badge/kill relabel via CSS content. */
html[data-fx=flap]{background:#1e1f22;--tile:#1c1c1c;
--hinge:linear-gradient(rgba(255,255,255,.05) 0 calc(50% - 1px),#000 calc(50% - 1px) calc(50% + 1px),rgba(0,0,0,.3) calc(50% + 1px))}
html[data-fx=flap] body{box-sizing:border-box;margin:1.2rem auto 2rem;padding:1rem 1.1rem 1.2rem;background:#0b0b0b;
border:6px solid #2b2c30;box-shadow:inset 0 0 0 1px #000,0 10px 30px rgba(0,0,0,.5);text-transform:uppercase;font-weight:700}
html[data-fx=flap] h1{font-size:0!important;color:#0b0b0b!important;margin:0 0 1rem;padding:.5rem .7rem;background:#ffc61a;
display:flex;align-items:center;justify-content:space-between;gap:1rem}
html[data-fx=flap] h1::before{content:'\\2708\\FE0E  PINEPORT';white-space:pre;font-size:1.25rem;letter-spacing:.12em}
html[data-fx=flap] h1::after{content:'DEPARTURES\\A' attr(data-host);white-space:pre;text-align:right;line-height:1.3;font-size:.65rem;letter-spacing:.2em}
html[data-fx=flap] table{border-collapse:separate;border-spacing:4px;font-size:.9rem;table-layout:fixed}
html[data-fx=flap] th:nth-child(2),html[data-fx=flap] th:nth-child(4){width:6.5rem}
html[data-fx=flap] th{font-size:0;border:0;padding:.2rem .6rem}
html[data-fx=flap] th::after{font-size:.7rem;letter-spacing:.2em;content:'FLIGHT'}
html[data-fx=flap] th:nth-child(2)::after{content:'MEM'}html[data-fx=flap] th:nth-child(3)::after{content:'GATE'}
html[data-fx=flap] th:nth-child(4)::after{content:'REMARKS'}
html[data-fx=flap] td{border:0;padding:.45rem .6rem;letter-spacing:.15em;background:var(--hinge),var(--tile);
border-radius:3px;box-shadow:inset 0 1px 0 rgba(255,255,255,.06);position:relative;overflow-wrap:break-word}
html[data-fx=flap] .fl{position:absolute;inset:0;padding:inherit;display:flex;align-items:center;pointer-events:none;
border-radius:3px;background:var(--hinge),var(--tile);--d:calc(var(--r,0)*45ms + var(--c,0)*30ms)}
html[data-fx=flap] .fl>span{width:100%}
html[data-fx=flap] .fl-ob,html[data-fx=flap] .fl-nb{clip-path:inset(50% 0 0 0)}
html[data-fx=flap] .fl-ot{clip-path:inset(0 0 50% 0);animation:flap-top .16s ease-in var(--d) both}
html[data-fx=flap] .fl-nb{animation:flap-bot .16s ease-out calc(var(--d) + .16s) both}
html[data-fx=flap] td:last-child{letter-spacing:.1em;font-size:.75rem;text-align:center;width:1%}
html[data-fx=flap] td:last-child:empty::after{content:'ON TIME';color:var(--dim)}
html[data-fx=flap] td:nth-child(2){--c:1}html[data-fx=flap] td:nth-child(3){--c:2}html[data-fx=flap] td:nth-child(4){--c:3}
html[data-fx=flap] tr:nth-child(2){--r:1}html[data-fx=flap] tr:nth-child(3){--r:2}html[data-fx=flap] tr:nth-child(4){--r:3}
html[data-fx=flap] tr:nth-child(5){--r:4}html[data-fx=flap] tr:nth-child(6){--r:5}html[data-fx=flap] tr:nth-child(7){--r:6}
html[data-fx=flap] tr:nth-child(8){--r:7}html[data-fx=flap] tr:nth-child(9){--r:8}html[data-fx=flap] tr:nth-child(n+10){--r:9}
html[data-fx=flap] a{text-decoration:none}html[data-fx=flap] a:hover{text-decoration:underline}
html[data-fx=flap] .badge{font-size:0;background:none;margin:0;padding:0;border-radius:0}
html[data-fx=flap] .badge::after{content:'\\A0 BOARDING';display:inline-block;overflow-wrap:normal;font-size:.9rem;color:#3ddc84;text-shadow:0 0 6px rgba(61,220,132,.5)}
html[data-fx=flap] button{border-radius:0;font-weight:700;background:var(--hinge),var(--killbg)}
html[data-fx=flap] button[data-p]{font-size:0;padding:.25rem .6rem}
html[data-fx=flap] button[data-p]::after{content:'CANCEL';font-size:.75rem;letter-spacing:.1em}
html[data-fx=flap] button[data-p]:hover{background:var(--kill)}
html[data-fx=flap] #stats{border:0;border-radius:0;background:#141414;letter-spacing:.05em}
html[data-fx=flap] .meter,html[data-fx=flap] .meter i{border-radius:0}
html[data-fx=flap] .meter i{color:var(--accent);background:repeating-linear-gradient(90deg,currentColor 0 .3rem,transparent .3rem .4rem)}
html[data-fx=flap] .warn i{color:var(--warn)}html[data-fx=flap] .crit i{color:var(--kill)}
html[data-fx=flap] #msg{color:var(--dim);font-size:.75rem;letter-spacing:.15em}
html[data-fx=flap] body:has(#pin){margin:0;border:0;box-shadow:none;min-height:100vh}
@media (max-width:600px){html[data-fx=flap] body{margin:.5rem;padding:.7rem .6rem}html[data-fx=flap] table{font-size:.8rem}
html[data-fx=flap] table{border-spacing:3px}html[data-fx=flap] th{padding:.2rem .35rem}
html[data-fx=flap] th::after{letter-spacing:.08em}
html[data-fx=flap] th:nth-child(2){width:4.1rem}html[data-fx=flap] th:nth-child(3){width:24%}
html[data-fx=flap] th:nth-child(4){width:1.8rem}html[data-fx=flap] th:nth-child(4)::after{content:''}html[data-fx=flap] h1::before{font-size:1rem}
