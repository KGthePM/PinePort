    from setproctitle import setproctitle
    setproctitle("pineports")
except ImportError:
    pass

LABELS = os.path.expanduser("~/.config/pineports-labels.conf")
PIN_FILE = os.path.expanduser("~/.config/pineports-pin")
WEB_PORT = 6310
HOST = socket.gethostname()  # self-identify: page + login name the machine it runs on

# new-listener badge: first-seen times per port; badged for 24h unless the
# port is labeled (declared expected) or ephemeral (VS Code/Firefox pick
# random high ports constantly).
SEEN_FILE = os.path.expanduser("~/.config/pineports-seen.json")
NEW_WINDOW = 24 * 3600
EPHEMERAL_MIN = 32768

# ---------- add-ons ----------
# An add-on is a CLI found on PATH that prints JSON. Found at startup -> its
# card renders and /api/addon/<name> serves it; absent -> quietly skipped.
# Contract: cmd --cached (instant, no network) and cmd (live; own cooldowns).

def _addon_cmd(name):
    """Resolve an add-on CLI. PATH first (normal case), then the known user
    install dir — a boot-time systemd user manager has no ~/.local/bin on
    PATH until a desktop session imports its environment."""
    hit = shutil.which(name)
    if hit:
        return hit
    fallback = os.path.join(os.path.expanduser("~/.local/bin"), name)
    return fallback if os.access(fallback, os.X_OK) else None

def _find_addons():
    a = {}
    needle = _addon_cmd("needle")
    if needle:
        a["needle"] = {"cmd": needle, "cached": ["--cached"], "live": [],
                       "timeout": (10, 120)}  # (cached, live) seconds
    pdock = _addon_cmd("pineports-docker")
    if pdock:
        a["docker"] = {"cmd": pdock, "cached": [], "live": [],
                       "timeout": (10, 10)}  # local socket, always fast
    return a

ADDONS = _find_addons()

def pin_hash():
    try:
        return open(PIN_FILE).read().strip()
    except FileNotFoundError:
        return None

SESSIONS = set()  # valid auth tokens (in-memory; re-login after restart)

def check_auth(handler):
    c = handler.headers.get("Cookie", "")
    for part in c.split(";"):
        if part.strip().startswith("ports_auth="):
            return part.strip().split("=", 1)[1] in SESSIONS
    return False

# ---------- data gathering ----------

def load_labels():
    m = {}
    try:
        for line in open(LABELS):
            line = line.strip()
            if line and not line.startswith("#") and ":" in line:
                port, name = line.split(":", 1)
                m[int(port.strip())] = name.strip()
    except FileNotFoundError:
        pass
    return m

def mem_mb(pid):
    try:
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("VmRSS:"):
                    return int(line.split()[1]) / 1024
    except (FileNotFoundError, ProcessLookupError, PermissionError):
        pass
    return None

def ss_out():
    r = subprocess.run(["/usr/bin/sudo", "-n", "/usr/bin/ss", "-tulpn"],
                       capture_output=True, text=True)
    if r.returncode == 0:
        return r.stdout
    return subprocess.run(["/usr/bin/ss", "-tulpn"], capture_output=True, text=True).stdout

_seen_lock = threading.Lock()

def load_seen():
    try:
        return json.load(open(SEEN_FILE))
    except (FileNotFoundError, ValueError):
        return {}

def save_seen(seen):
    tmp = SEEN_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(seen, f)
    os.replace(tmp, SEEN_FILE)

def badge_ports(ports, labels):
    """Mark ports first seen within NEW_WINDOW. Labeled + ephemeral ports are
    exempt: the first are declared expected, the second appear/disappear
    constantly (VS Code, Firefox)."""
    now = time.time()
    with _seen_lock:
        seen = load_seen()
        changed = False
        badged = []
        for p in ports:
            if p not in seen:
                seen[p] = now
                changed = True
            if (now - seen[p] < NEW_WINDOW and p not in labels
                    and p < EPHEMERAL_MIN):
                badged.append(p)
        if changed:
            try:
                save_seen(seen)
            except OSError:
                pass  # badge state is best-effort
        return badged

def gather():
    """-> list of dicts: name, pid, rss, ports(list), kind ('user'|'docker'|'system')"""
    labels = load_labels()
    services = {}
    for line in ss_out().splitlines()[1:]:
        parts = line.split()
        if len(parts) < 5 or ("LISTEN" not in line and "UNCONN" not in line):
            continue
        addr = parts[4]
        if addr.startswith("[") and "]" in addr:
            port = int(addr.rsplit("]", 1)[1].lstrip(":"))
        else:
            port = int(addr.rsplit(":", 1)[1])
        name = pid = ""
        if "users:" in line:
            seg = line.split('(("', 1)[1]
            name = seg.split('"', 1)[0]
            pid = seg.split("pid=", 1)[1].split(",", 1)[0]
        if not pid or not pid.isdigit():
            pid = "0"
        s = services.setdefault(pid, {"name": name, "ports": set()})
        s["ports"].add(port)
        if port in labels:
            s["name"] = labels[port]

    out = []
    for pid, s in services.items():
        if pid == "0" or not s["name"]:
            continue
        rss = mem_mb(pid)
        kind = "user"
        if "docker" in s["name"] or "containerd" in s["name"]:
            kind = "docker"
        out.append({"name": s["name"], "pid": pid, "rss": rss,
                    "ports": sorted(s["ports"]), "kind": kind,
                    "new": badge_ports(sorted(s["ports"]), labels)})
    # merge same-name entries, keep the one with rss
    merged = {}
    for e in out:
        k = e["name"]
        if k in merged:
            merged[k]["ports"] = sorted(set(merged[k]["ports"]) | set(e["ports"]))
            if e["rss"] and not merged[k]["rss"]:
                merged[k]["rss"] = e["rss"]
                merged[k]["pid"] = e["pid"]
        else:
            merged[k] = e
    return sorted(merged.values(), key=lambda e: -(e["rss"] or 0))

# ---------- system stats ----------

_last_stat = None  # (t, idle_ticks, total_ticks) for cpu delta between polls

def cpu_pct():
    """CPU busy % between the last two calls (web UI polls every 5s)."""
    global _last_stat
    with open("/proc/stat") as f:
        nums = list(map(int, f.readline().split()[1:]))
    idle = nums[3] + (nums[4] if len(nums) > 4 else 0)
    total = sum(nums)
    now = time.time()
    pct = 0.0
    if _last_stat:
        didle, dtotal = idle - _last_stat[1], total - _last_stat[2]
        if dtotal > 0:
            pct = 100.0 * (1.0 - didle / dtotal)
    _last_stat = (now, idle, total)
    return round(pct, 1)

def sys_stats():
    mi = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            mi[k] = int(v.strip().split()[0])  # kB
    total, avail = mi["MemTotal"], mi["MemAvailable"]
    used = total - avail
    st = os.statvfs("/")
    disk_pct = 100.0 * (1.0 - st.f_bavail / st.f_blocks)
    up = int(float(open("/proc/uptime").read().split()[0]))
    d, rem = divmod(up, 86400)
    h, m = divmod(rem, 3600)
    m //= 60
    return {
        "ram_pct": round(100.0 * used / total, 1),
        "ram_used": round(used / 1048576, 1), "ram_total": round(total / 1048576, 1),
        "cpu_pct": cpu_pct(), "disk_pct": round(disk_pct, 1),
        "disk_free": round(st.f_bavail * st.f_frsize / 2**30, 0),
        "uptime": f"{d}d {h}h {m}m" if d else f"{h}h {m}m",
        "load1": round(os.getloadavg()[0], 2),
    }

# ---------- kill ----------

def docker_container_for_port(port):
    """container id publishing <port>, or None"""
    r = subprocess.run(["/usr/bin/docker", "ps", "-q"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    for cid in r.stdout.split():
        ins = subprocess.run(["/usr/bin/docker", "inspect", "--format",
                              "{{json .NetworkSettings.Ports}}", cid],
                             capture_output=True, text=True).stdout
        if f'"HostPort":"{port}"' in ins.replace(" ", ""):
            return cid
    return None

def kill_port(port):
    port = int(port)
    # docker-published port?
    cid = docker_container_for_port(port)
    if cid:
        name = subprocess.run(["/usr/bin/docker", "inspect", "--format",
                               "{{.Name}}", cid], capture_output=True,
                              text=True).stdout.strip()
        r = subprocess.run(["/usr/bin/docker", "stop", "--timeout", "5", cid],
                           capture_output=True, text=True)
        return (f"stopped docker container {name} (was publishing :{port})"
                if r.returncode == 0 else f"docker stop failed: {r.stderr.strip()}")

    # local process
    for line in ss_out().splitlines():
        parts = line.split()
        if len(parts) > 4 and "users:" in line:
            addr = parts[4]
            if addr.startswith("["):
                p = addr.rsplit("]", 1)[-1].lstrip(":")
            else:
                bits = addr.rsplit(":", 1)
                p = bits[1] if len(bits) == 2 else ""
            if p == str(port):
                seg = line.split('(("', 1)[1]
                name = seg.split('"', 1)[0]
                pid = seg.split("pid=", 1)[1].split(",", 1)[0]
                try:
                    os.kill(int(pid), signal.SIGTERM)
                    return f"sent SIGTERM to {name} (pid {pid}) on :{port}"
                except ProcessLookupError:
                    return f"pid {pid} already gone"
                except PermissionError:
                    r = subprocess.run(["/usr/bin/sudo", "-n", "/usr/bin/kill",
                                        pid], capture_output=True, text=True)
                    if r.returncode == 0:
                        return f"sent SIGTERM to {name} (pid {pid}) on :{port} (root)"
                    return f"no permission to kill pid {pid} (system service?)"
    return f"nothing listening on :{port}"

# ---------- CLI table ----------

def print_table():
    print(f"{'SERVICE':<24} {'MEM':>8}  PORTS")
    print("-" * 66)
    total = 0
    for e in gather():
        mem = f"{e['rss']:.0f} MB" if e["rss"] else "-"
        if e["rss"]:
            total += e["rss"]
        print(f"{e['name'][:24]:<24} {mem:>8}  {', '.join(map(str, e['ports']))}")
    print("-" * 66)
    print(f"{len(gather())} services, {total/1024:.1f} GB RAM total")

