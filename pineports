def print_table():
    print(f"{'SERVICE':<24} {'MEM':>8}  PORTS")
    print("-" * 66)
    total = 0
    rows = gather()
    for e in rows:
        mem = f"{e['rss']:.0f} MB" if e["rss"] else "-"
        if e["rss"]:
            total += e["rss"]
        print(f"{e['name'][:24]:<24} {mem:>8}  {', '.join(map(str, e['ports']))}")
    print("-" * 66)
    print(f"{len(rows)} services, {total/1024:.1f} GB RAM total")

