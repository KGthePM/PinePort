#!/usr/bin/env python3
"""ports — what's running on this PC: ports, memory, kill, web view.

Usage:
  ports                 show table
  ports kill <port>     stop whatever listens on <port>
  ports -w / --web      serve web UI on :6310 (for LAN/Tailscale)
  ports --set-pin       create or replace the web UI PIN
"""
import subprocess, os, sys, signal, json, hashlib, secrets, time, shutil, threading, socket, base64
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
try:
    from setproctitle import setproctitle
    setproctitle("pineports")
except ImportError:
    pass

# ---------- platform / config ----------
# Windows keeps the same filenames under %APPDATA%\pineports\; Linux keeps
# ~/.config/ as before. One base dir, computed once.
IS_WIN = sys.platform == "win32"

def CONFIG_PATH(fname):
    base = (os.path.join(os.environ.get("APPDATA", os.path.expanduser("~")),
                         "pineports") if IS_WIN
            else os.path.join(os.path.expanduser("~"), ".config"))
    if IS_WIN:
        os.makedirs(base, exist_ok=True)
    return os.path.join(base, fname)

LABELS = CONFIG_PATH("pineports-labels.conf")
PIN_FILE = CONFIG_PATH("pineports-pin")
WEB_PORT = 6310
HOST = socket.gethostname()  # self-identify: page + login name the machine it runs on

# new-listener badge: first-seen times per port; badged for 24h unless the
# port is labeled (declared expected) or ephemeral (VS Code/Firefox pick
# random high ports constantly).
SEEN_FILE = CONFIG_PATH("pineports-seen.json")
NEW_WINDOW = 24 * 3600
EPHEMERAL_MIN = 32768
DOCKER = "docker" if IS_WIN else "/usr/bin/docker"

# ---------- add-ons ----------
# An add-on is a CLI found on PATH that prints JSON. Found at startup -> its
# card renders and /api/addon/<name> serves it; absent -> quietly skipped.
# Contract: cmd --cached (instant, no network) and cmd (live; own cooldowns).

def _addon_cmd(name):
    """Resolve an add-on CLI. PATH first (normal case), then the known user
    install locations that may be absent from service-manager PATHs."""
    hit = shutil.which(name)
    if hit:
        return hit
    if IS_WIN:
        py_hit = shutil.which(name + ".py")
        if py_hit:
            return [sys.executable, py_hit]
        if name == "needle":
            local = os.environ.get("LOCALAPPDATA")
            if local:
                needle = os.path.join(local, "Needle", "bin", "needle.py")
                if os.path.isfile(needle):
                    return [sys.executable, needle]
    fallback = os.path.join(os.path.expanduser("~/.local/bin"), name)
    return fallback if os.access(fallback, os.X_OK) else None

def _find_addons():
    a = {}
    needle = _addon_cmd("needle")
    if needle:
        a["needle"] = {"cmd": needle, "cached": ["--cached"], "live": [],
                       "timeout": (10, 120)}  # (cached, live) seconds
    pdock = _addon_cmd("pineports-docker")
    if not pdock and IS_WIN:
        bundled = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                               "pineports-docker")
        if os.path.isfile(bundled):
            pdock = [sys.executable, bundled]
    if pdock:
        a["docker"] = {"cmd": pdock, "cached": [], "live": [],
                        "timeout": (10, 10)}  # local socket, always fast
    return a

ADDONS = _find_addons()

# ---------- Windows data collection (IS_WIN) ----------
# Listener list: PowerShell Get-NetTCPConnection -State Listen (built into
# Win10+). Per-pid name/RSS/cmdline + system stats: psutil (pip install
# psutil). Without psutil the table still shows ports + pids, just no
# names/RAM, and the stats bar reads zeros.

_psutil = None  # psutil handle; set below on Windows (tests patch this here)
if IS_WIN:
    try:
        import psutil as _psutil
    except ImportError:
        pass

def _ps_json(cmdlet):
    """Run a PowerShell cmdlet, return parsed JSON (list-normalized) or None."""
    try:
        r = subprocess.run(["powershell", "-NoProfile", "-Command",
                            f"{cmdlet} | ConvertTo-Json -Compress"],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0 or not r.stdout.strip():
        return None
    try:
        d = json.loads(r.stdout)
    except ValueError:
        return None
    return d if isinstance(d, list) else [d]

def win_listeners():
    """[(pid, port, external)] for TCP LISTEN sockets; external = bound off
    loopback (rendered as clickable links, same rule as Linux)."""
    rows = _ps_json("Get-NetTCPConnection -State Listen")
    out = []
    for c in rows or []:
        try:
            pid = int(c.get("OwningProcess") or 0)
            port = int(c.get("LocalPort") or 0)
        except (TypeError, ValueError):
            continue
        if pid and port:
            out.append((pid, port, not _is_loopback(str(c.get("LocalAddress") or ""))))
    return out

def win_proc(pid):
    """(name, rss_mb, cmdline) for a pid; ('', None, '') if unknown."""
    if not _psutil:
        return "", None, ""
    try:
        p = _psutil.Process(pid)
        with p.oneshot():
            return (p.name(), p.memory_info().rss / 1048576,
                    " ".join(p.cmdline())[:300])
    except Exception:
        try:
            return _psutil.Process(pid).name(), None, ""
        except Exception:
            return "", None, ""

_last_win_cpu = None  # (t, idle, total) for cpu delta between polls

def win_cpu_pct():
    global _last_win_cpu
    if not _psutil:
        return 0.0
    t = _psutil.cpu_times()
    idle = t.idle + getattr(t, "iowait", 0.0)
    total = sum(t)
    pct = 0.0
    if _last_win_cpu:
        didle, dtotal = idle - _last_win_cpu[1], total - _last_win_cpu[2]
        if dtotal > 0:
            pct = 100.0 * (1.0 - didle / dtotal)
    _last_win_cpu = (time.time(), idle, total)
    return round(pct, 1)

# Same idea as default_iface() on Linux: skip adapters that carry traffic
# already counted on the physical NIC (loopback, Hyper-V/WSL/Docker
# switches, the Tailscale tunnel).
_WIN_SKIP_NICS = ("loopback", "vethernet", "tailscale")

def win_net():
    """(down, up) bytes/s summed over physical-ish adapters."""
    try:
        nics = _psutil.net_io_counters(pernic=True)
    except Exception:
        return 0, 0
    rx = tx = 0
    for name, c in nics.items():
        if not any(k in name.lower() for k in _WIN_SKIP_NICS):
            rx += c.bytes_recv
            tx += c.bytes_sent
    return net_rate("win", rx, tx)

def win_conns():
    """Established TCP connections, loopback-to-loopback excluded."""
    try:
        conns = _psutil.net_connections(kind="tcp")
    except Exception:
        return 0
    return sum(1 for c in conns if c.status == "ESTABLISHED" and c.raddr
               and not _is_loopback(c.raddr.ip))

def win_sys_stats():
    if not _psutil:
        return {"ram_pct": 0.0, "ram_used": 0.0, "ram_total": 0.0,
                "cpu_pct": 0.0, "disk_pct": 0.0, "disk_free": 0.0,
                "uptime": "-", "load1": 0.0,
                "net_down": 0, "net_up": 0, "conns": 0}
    vm = _psutil.virtual_memory()
    drive = os.path.splitdrive(os.path.expanduser("~"))[0] + os.sep or "C:" + os.sep
    du = _psutil.disk_usage(drive)
    up = int(time.time() - _psutil.boot_time())
    d, rem = divmod(up, 86400)
    h, m = divmod(rem, 3600)
    m //= 60
    net = win_net()
    return {
        "ram_pct": round(vm.percent, 1),
        "ram_used": round(vm.used / 1048576, 1),
        "ram_total": round(vm.total / 1048576, 1),
        "cpu_pct": win_cpu_pct(),
        "disk_pct": round(du.percent, 1),
        "disk_free": round(du.free / 2**30, 0),
        "uptime": f"{d}d {h}h {m}m" if d else f"{h}h {m}m",
        "load1": 0.0,  # no loadavg on Windows
        "net_down": net[0], "net_up": net[1], "conns": win_conns(),
    }

def win_gather():
    """Same row schema as gather(): one row per pid, docker ports detected
    via the publishing process, labels override process names."""
    labels = load_labels()
    services = {}
    for pid, port, external in win_listeners():
        s = services.setdefault(pid, {"ports": set(), "links": set()})
        s["ports"].add(port)
        if external:
            s["links"].add(port)
    out = []
    for pid, s in services.items():
        name, rss, cmd = win_proc(pid)
        for p in s["ports"]:
            if p in labels:
                name = labels[p]
                break
        if not name:
            name = f"pid {pid}"
        lname = name.lower()
        kind = "docker" if ("docker" in lname or "containerd" in lname
                            or "vpnkit" in lname) else "user"
        ports = sorted(s["ports"])
        out.append({"name": name, "pid": pid, "rss": rss, "cmd": cmd,
                    "ports": ports, "links": sorted(s["links"]), "kind": kind,
                    "new": badge_ports(ports, labels)})
    return sorted(out, key=lambda e: -(e["rss"] or 0))

def win_kill_pid(pid, port):
    """terminate() then kill(); honest error for other users' processes."""
    if not _psutil:
        return "psutil not installed — run: pip install psutil"
    try:
        p = _psutil.Process(pid)
        pname = p.name()
    except _psutil.NoSuchProcess:
        return f"pid {pid} already gone"
    except Exception as ex:
        return f"cannot inspect pid {pid}: {ex}"
    try:
        p.terminate()
        try:
            p.wait(timeout=5)
        except Exception:
            p.kill()
            p.wait(timeout=5)
        return f"stopped {pname} (pid {pid}) on :{port}"
    except _psutil.AccessDenied:
        return (f"no permission to kill {pname} (pid {pid}) — it belongs to "
                "another user; run from an elevated (Run as administrator) console")
    except Exception as ex:
        return f"failed to kill pid {pid}: {ex}"

def win_kill_port(port, expected_pid=None):
    port = int(port)
    listeners = None
    if expected_pid is not None:
        expected_pid = int(expected_pid)
        listeners = win_listeners()
        if not any(pid == expected_pid and p == port
                   for pid, p, _ext in listeners):
            return f"listener on :{port} changed; refresh and try again"
    try:
        cid = docker_container_for_port(port)
    except DockerTimeout:
        return "docker lookup timed out; nothing was stopped"
    if cid:
        if expected_pid is not None and not any(
                pid == expected_pid and p == port
                for pid, p, _ext in win_listeners()):
            return f"listener on :{port} changed; refresh and try again"
        try:
            name = subprocess.run(
                [DOCKER, "inspect", "--format", "{{.Name}}", cid],
                capture_output=True, text=True, timeout=5).stdout.strip()
            r = subprocess.run([DOCKER, "stop", "--timeout", "5", cid],
                               capture_output=True, text=True, timeout=10)
        except subprocess.TimeoutExpired:
            return "docker stop timed out; the container may still be running"
        return (f"stopped docker container {name} (was publishing :{port})"
                if r.returncode == 0 else f"docker stop failed: {r.stderr.strip()}")
    if expected_pid is not None:
        if any(pid == expected_pid and p == port
               for pid, p, _ext in win_listeners()):
            return win_kill_pid(expected_pid, port)
        return f"listener on :{port} changed; refresh and try again"
    for pid, p, _ext in win_listeners():
        if p == port:
            return win_kill_pid(pid, port)
    return f"nothing listening on :{port}"

# ---------- data gathering ----------

def pin_hash():
    try:
        with open(PIN_FILE) as f:
            return f.read().strip()
    except FileNotFoundError:
        return None

def set_pin():
    from getpass import getpass
    pin = getpass("Dashboard PIN (4 digits): ")
    confirm = getpass("Confirm PIN: ")
    if len(pin) != 4 or not pin.isdigit():
        raise SystemExit("PIN must be exactly 4 digits")
    if pin != confirm:
        raise SystemExit("PINs do not match")
    os.makedirs(os.path.dirname(PIN_FILE), exist_ok=True)
    tmp = f"{PIN_FILE}.{os.getpid()}.tmp"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(hashlib.sha256(pin.encode()).hexdigest() + "\n")
        os.replace(tmp, PIN_FILE)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
    print(f"PIN saved to {PIN_FILE}")

SESSIONS = {}  # auth token -> PIN hash; changing the PIN revokes old sessions

# Login throttle is global, not per-request: the threaded server would let
# parallel guesses each sleep on their own thread, so a 4-digit PIN falls in
# minutes. After LOGIN_MAX_FAILS wrong PINs, all logins wait LOGIN_LOCKOUT.
LOGIN_MAX_FAILS = 5
LOGIN_LOCKOUT = 300
_login_lock = threading.Lock()
_login_fails = 0
_login_locked_until = 0.0

def try_login(pin):
    """-> 'ok' | 'wrong' | 'locked'. Check + count under one lock so
    concurrent guesses can't slip past the limit."""
    global _login_fails, _login_locked_until
    with _login_lock:
        if time.time() < _login_locked_until:
            return "locked"
        want = pin_hash()
        if want and secrets.compare_digest(
                hashlib.sha256(pin.encode()).hexdigest(), want):
            _login_fails = 0
            return "ok"
        _login_fails += 1
        if _login_fails >= LOGIN_MAX_FAILS:
            _login_fails = 0
            _login_locked_until = time.time() + LOGIN_LOCKOUT
        return "wrong"

def check_auth(handler):
    c = handler.headers.get("Cookie", "")
    for part in c.split(";"):
        if part.strip().startswith("ports_auth="):
            token = part.strip().split("=", 1)[1]
            session_pin = SESSIONS.get(token, "")
            current_pin = pin_hash() or ""
            if session_pin and secrets.compare_digest(session_pin, current_pin):
                return True
            SESSIONS.pop(token, None)
    return False

# ---------- data gathering ----------

def load_labels():
    m = {}
    try:
        for line in open(LABELS):
            line = line.strip()
            if line and not line.startswith("#") and ":" in line:
                port, name = line.split(":", 1)
                m[int(port.strip())] = name.strip()
    except FileNotFoundError:
        pass
    return m

def mem_mb(pid):
    try:
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("VmRSS:"):
                    return int(line.split()[1]) / 1024
    except (FileNotFoundError, ProcessLookupError, PermissionError):
        pass
    return None

def cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return f.read().replace(b"\0", b" ").decode(errors="replace").strip()[:300]
    except (FileNotFoundError, ProcessLookupError, PermissionError):
        return ""

def _is_loopback(host):
    host = host.split("%", 1)[0].strip("[]")
    return host.startswith("127.") or host in ("::1", "localhost") \
        or host.startswith("::ffff:127.")

def ss_out():
    r = subprocess.run(["/usr/bin/sudo", "-n", "/usr/bin/ss", "-tulpn"],
                       capture_output=True, text=True)
    if r.returncode == 0:
        return r.stdout
    return subprocess.run(["/usr/bin/ss", "-tulpn"], capture_output=True, text=True).stdout

_seen_lock = threading.Lock()

def load_seen():
    try:
        with open(SEEN_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}

def save_seen(seen):
    tmp = SEEN_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(seen, f)
    os.replace(tmp, SEEN_FILE)

def badge_ports(ports, labels):
    """Mark ports first seen within NEW_WINDOW. Labeled + ephemeral ports are
    exempt: the first are declared expected, the second appear/disappear
    constantly (VS Code, Firefox)."""
    now = time.time()
    with _seen_lock:
        seen = load_seen()
        changed = False
        badged = []
        for p in ports:
            if p not in seen:
                seen[p] = now
                changed = True
            if (now - seen[p] < NEW_WINDOW and p not in labels
                    and p < EPHEMERAL_MIN):
                badged.append(p)
        if changed:
            try:
                save_seen(seen)
            except OSError:
                pass  # badge state is best-effort
        return badged

def linux_gather():
    """-> list of dicts, one per pid: name, pid, rss, cmd, ports(list),
    links (tcp ports reachable off-box), kind ('user'|'docker'), new"""
    labels = load_labels()
    services = {}
    for line in ss_out().splitlines()[1:]:
        parts = line.split()
        if len(parts) < 5 or ("LISTEN" not in line and "UNCONN" not in line):
            continue
        addr = parts[4]
        host, _, port = addr.rpartition(":")
        port = int(port)
        name = pid = ""
        if "users:" in line:
            seg = line.split('(("', 1)[1]
            name = seg.split('"', 1)[0]
            pid = seg.split("pid=", 1)[1].split(",", 1)[0]
        if not pid or not pid.isdigit():
            pid = "0"
        s = services.setdefault(pid, {"name": name, "ports": set(), "links": set()})
        s["ports"].add(port)
        if parts[0] == "tcp" and not _is_loopback(host):
            s["links"].add(port)
        if port in labels:
            s["name"] = labels[port]

    out = []
    for pid, s in services.items():
        if pid == "0" or not s["name"]:
            continue
        rss = mem_mb(pid)
        kind = "user"
        if "docker" in s["name"] or "containerd" in s["name"]:
            kind = "docker"
        out.append({"name": s["name"], "pid": pid, "rss": rss,
                    "cmd": cmdline(pid),
                    "ports": sorted(s["ports"]), "links": sorted(s["links"]),
                    "kind": kind,
                    "new": badge_ports(sorted(s["ports"]), labels)})
    # one row per pid, no merging by name: two `node` servers are two rows,
    # each with its own RAM and a kill button that hits that pid
    return sorted(out, key=lambda e: -(e["rss"] or 0))

# platform dispatch — same name, per-OS implementation
gather = win_gather if IS_WIN else linux_gather

# ---------- system stats ----------

_last_stat = None  # (t, idle_ticks, total_ticks) for cpu delta between polls

def cpu_pct():
    """CPU busy % between the last two calls (web UI polls every 5s)."""
    global _last_stat
    with open("/proc/stat") as f:
        nums = list(map(int, f.readline().split()[1:]))
    idle = nums[3] + (nums[4] if len(nums) > 4 else 0)
    total = sum(nums)
    now = time.time()
    pct = 0.0
    if _last_stat:
        didle, dtotal = idle - _last_stat[1], total - _last_stat[2]
        if dtotal > 0:
            pct = 100.0 * (1.0 - didle / dtotal)
    _last_stat = (now, idle, total)
    return round(pct, 1)

_last_net = None  # (t, key, rx, tx) for throughput delta between polls

def net_rate(key, rx, tx):
    """(down, up) bytes/s since the last call. key names what the counters
    came from; if it changes (new default route) the delta is meaningless."""
    global _last_net
    now = time.monotonic()
    down = up = 0.0
    if _last_net and _last_net[1] == key and now > _last_net[0]:
        dt = now - _last_net[0]
        down = max(0.0, (rx - _last_net[2]) / dt)
        up = max(0.0, (tx - _last_net[3]) / dt)
    _last_net = (now, key, rx, tx)
    return round(down), round(up)

def default_iface():
    """Interface of the lowest-metric IPv4 default route, or None. Only this
    one is counted: lo/docker0/tailscale0 would double-count the same bytes."""
    best = None
    try:
        with open("/proc/net/route") as f:
            next(f)
            for line in f:
                p = line.split()
                if len(p) > 6 and p[1] == "00000000" and int(p[3], 16) & 1:  # RTF_UP
                    if best is None or int(p[6]) < best[1]:
                        best = (p[0], int(p[6]))
    except (OSError, ValueError, StopIteration):
        return None
    return best and best[0]

def linux_net():
    """(down, up) bytes/s on the default-route interface."""
    iface = default_iface()
    rx = tx = 0
    try:
        with open("/proc/net/dev") as f:
            for line in f:
                name, _, rest = line.partition(":")
                if name.strip() == iface:
                    v = rest.split()
                    rx, tx = int(v[0]), int(v[8])
    except (OSError, ValueError, IndexError):
        pass
    return net_rate(iface, rx, tx)

def _hex_loopback(addr):
    """True if a /proc/net/tcp{,6} hex address (no port) is loopback."""
    if len(addr) == 8:  # little-endian IPv4: 127.x.x.x ends in 7F
        return addr.endswith("7F")
    return (addr == "00000000000000000000000001000000"  # ::1
            or (addr.startswith("0000000000000000FFFF0000") and addr.endswith("7F")))

def linux_conns():
    """Established TCP connections, not counting loopback-to-loopback ones
    (local services talking to each other would show up twice)."""
    n = 0
    for path in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(path) as f:
                next(f)
                for line in f:
                    p = line.split()
                    if len(p) > 3 and p[3] == "01" and not _hex_loopback(p[2].split(":")[0]):
                        n += 1
        except (OSError, StopIteration):
            pass
    return n

def linux_sys_stats():
    mi = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            mi[k] = int(v.strip().split()[0])  # kB
    total, avail = mi["MemTotal"], mi["MemAvailable"]
    used = total - avail
    st = os.statvfs("/")
    disk_pct = 100.0 * (1.0 - st.f_bavail / st.f_blocks)
    up = int(float(open("/proc/uptime").read().split()[0]))
    d, rem = divmod(up, 86400)
    h, m = divmod(rem, 3600)
    m //= 60
    net = linux_net()
    return {
        "ram_pct": round(100.0 * used / total, 1),
        "ram_used": round(used / 1048576, 1), "ram_total": round(total / 1048576, 1),
        "cpu_pct": cpu_pct(), "disk_pct": round(disk_pct, 1),
        "disk_free": round(st.f_bavail * st.f_frsize / 2**30, 0),
        "uptime": f"{d}d {h}h {m}m" if d else f"{h}h {m}m",
        "load1": round(os.getloadavg()[0], 2),
        "net_down": net[0], "net_up": net[1], "conns": linux_conns(),
    }

sys_stats = win_sys_stats if IS_WIN else linux_sys_stats

# ---------- kill ----------

class DockerTimeout(Exception):
    pass

def docker_container_for_port(port):
    """container id publishing <port>, or None"""
    try:
        r = subprocess.run([DOCKER, "ps", "-q"],
                           capture_output=True, text=True, timeout=5)
    except OSError:
        return None
    except subprocess.TimeoutExpired as ex:
        raise DockerTimeout from ex
    if r.returncode != 0:
        return None
    for cid in r.stdout.split():
        try:
            ins = subprocess.run([DOCKER, "inspect", "--format",
                                  "{{json .NetworkSettings.Ports}}", cid],
                                 capture_output=True, text=True,
                                 timeout=5).stdout
        except subprocess.TimeoutExpired as ex:
            raise DockerTimeout from ex
        if f'"HostPort":"{port}"' in ins.replace(" ", ""):
            return cid
    return None

def linux_port_owned_by_pid(port, pid):
    for line in ss_out().splitlines():
        parts = line.split()
        if len(parts) <= 4 or "users:" not in line:
            continue
        addr = parts[4]
        p = (addr.rsplit("]", 1)[-1].lstrip(":") if addr.startswith("[")
             else addr.rsplit(":", 1)[-1])
        if p == str(port) and f"pid={pid}," in line:
            return True
    return False

def linux_kill_port(port, expected_pid=None):
    port = int(port)
    if expected_pid is not None and not linux_port_owned_by_pid(port, expected_pid):
        return f"listener on :{port} changed; refresh and try again"
    # docker-published port?
    try:
        cid = docker_container_for_port(port)
    except DockerTimeout:
        return "docker lookup timed out; nothing was stopped"
    if cid:
        if expected_pid is not None and not linux_port_owned_by_pid(port, expected_pid):
            return f"listener on :{port} changed; refresh and try again"
        try:
            name = subprocess.run(
                ["/usr/bin/docker", "inspect", "--format", "{{.Name}}", cid],
                capture_output=True, text=True, timeout=5).stdout.strip()
            r = subprocess.run(["/usr/bin/docker", "stop", "--timeout", "5", cid],
                               capture_output=True, text=True, timeout=10)
        except subprocess.TimeoutExpired:
            return "docker stop timed out; the container may still be running"
        return (f"stopped docker container {name} (was publishing :{port})"
                if r.returncode == 0 else f"docker stop failed: {r.stderr.strip()}")

    # local process
    for line in ss_out().splitlines():
        parts = line.split()
        if len(parts) > 4 and "users:" in line:
            addr = parts[4]
            if addr.startswith("["):
                p = addr.rsplit("]", 1)[-1].lstrip(":")
            else:
                bits = addr.rsplit(":", 1)
                p = bits[1] if len(bits) == 2 else ""
            if p == str(port):
                seg = line.split('(("', 1)[1]
                name = seg.split('"', 1)[0]
                pid = seg.split("pid=", 1)[1].split(",", 1)[0]
                if expected_pid is not None and pid != str(expected_pid):
                    continue
                try:
                    os.kill(int(pid), signal.SIGTERM)
                    return f"sent SIGTERM to {name} (pid {pid}) on :{port}"
                except ProcessLookupError:
                    return f"pid {pid} already gone"
                except PermissionError:
                    r = subprocess.run(["/usr/bin/sudo", "-n", "/usr/bin/kill",
                                        pid], capture_output=True, text=True)
                    if r.returncode == 0:
                        return f"sent SIGTERM to {name} (pid {pid}) on :{port} (root)"
                    return f"no permission to kill pid {pid} (system service?)"
    if expected_pid is not None:
        return f"listener on :{port} changed; refresh and try again"
    return f"nothing listening on :{port}"

kill_port = win_kill_port if IS_WIN else linux_kill_port

