body{font-family:ui-monospace,Menlo,Consolas,monospace;background:var(--bg);color:var(--fg);
max-width:760px;margin:2rem auto;padding:0 1rem}
h1{font-size:1.1rem;color:var(--accent)}table{border-collapse:collapse;width:100%}
td,th{padding:.45rem .6rem;text-align:left;border-bottom:1px solid var(--line)}
th{color:var(--dim);font-weight:normal;font-size:.8rem}
.mem{text-align:right}a{color:var(--accent)}td[title]{cursor:help}.dead{color:var(--kill)}
.badge{display:inline-block;background:var(--warnbg);color:var(--warn);border-radius:4px;
font-size:.7rem;padding:.05rem .4rem;margin-left:.35rem;font-weight:normal}
button{background:var(--killbg);color:var(--kill);border:1px solid var(--kill);border-radius:4px;
padding:.15rem .6rem;cursor:pointer;font-family:inherit}
button:hover{background:var(--kill);color:var(--bg)}
#msg{margin-top:1rem;color:var(--accent);min-height:1.2rem}
/* stats bar */
#stats{display:flex;flex-wrap:wrap;gap:.4rem 1.4rem;padding:.6rem .8rem;margin:0 0 1.2rem;
border:1px solid var(--line);border-radius:6px;font-size:.85rem}
#stats b{color:var(--accent);font-weight:normal}
.meter{display:inline-block;width:5.5rem;height:.45rem;background:var(--barbg);
border-radius:3px;vertical-align:middle;margin-left:.35rem;overflow:hidden}
.meter i{display:block;height:100%;background:var(--accent);border-radius:3px}
.warn i{background:var(--warn)}.crit i{background:var(--kill)}
/* theme picker */
#theme{display:flex;flex-wrap:wrap;gap:.45rem;margin:-.6rem 0 1rem}
#theme span{width:1.15rem;height:1.15rem;border-radius:50%;cursor:pointer;
border:2px solid transparent;display:inline-block}
#theme span.sel{border-color:var(--fg)}
</style></head><body>
<h1>PinePorts — what's running on __HOST__</h1>
<div id=stats></div>
<div id=theme></div>
<table id=t><thead><tr>
<th>SERVICE</th><th class=mem>MEM</th><th>PORTS</th><th></th></tr></thead>
<tbody></tbody></table><div id=msg></div>
<div id=addons></div>
<script>
const ADDONS=__ADDONS__;
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
const own=['cupsd','avahi-daemon','tailscaled','systemd','AdGuardHome'];
function applyTheme(t){theme=t;try{localStorage.setItem('pp_theme',t)}catch(e){}
 paint(t);
 document.querySelectorAll('#theme span').forEach(el=>el.classList.toggle('sel',el.dataset.t===t));}
function meter(pct){const cls=pct>90?'crit':pct>75?'warn':'';
 return `<span class="meter ${cls}"><i style="width:${Math.min(pct,100)}%"></i></span>`}
async function refresh(){
 const r=await fetch('/api/services');const d=await r.json();
 const st=d.stats;
 document.querySelector('#stats').innerHTML=
  `<span>CPU <b>${st.cpu_pct}%</b>${meter(st.cpu_pct)}</span>`+
  `<span>RAM <b>${st.ram_used}/${st.ram_total}G</b> <b>${st.ram_pct}%</b>${meter(st.ram_pct)}</span>`+
  `<span>DISK <b>${st.disk_pct}%</b>${meter(st.disk_pct)}</span>`+
  `<span>free <b>${st.disk_free}G</b></span>`+
  `<span>load <b>${st.load1}</b></span><span>up <b>${st.uptime}</b></span>`;
 const tb=document.querySelector('#t tbody');tb.innerHTML='';
 d.services.forEach(s=>{
  const tr=document.createElement('tr');
  const sys=own.some(o=>s.name.includes(o));
  const ports=s.ports.map(p=>{
   const t=(s.links||[]).includes(p)?`<a href="http://${location.hostname}:${p}/" target=_blank rel=noopener>${p}</a>`:p;
   return s.new&&s.new.includes(p)?t+'<span class="badge">new</span>':t}).join(', ');
  tr.innerHTML=`<td title="${esc('pid '+s.pid+(s.cmd?'\\n'+s.cmd:''))}">${esc(s.name)}</td><td class=mem>${s.rss?s.rss.toFixed(0)+' MB':'-'}</td>
   <td>${ports}</td><td>${sys?'':'<button data-p="'+s.ports[0]+'" data-n="'+esc(s.name+' (pid '+s.pid+')')+'">kill</button>'}</td>`;
  tb.appendChild(tr);});
 document.querySelector('#msg').textContent=d.services.length+' services, '
  +(d.total/1024).toFixed(1)+' GB RAM — updated '+new Date().toLocaleTimeString();
}
/* build theme dots */
const tdiv=document.querySelector('#theme');
for(const t of['auto',...Object.keys(THEMES)]){const el=document.createElement('span');
 el.dataset.t=t;el.title=t==='auto'?'auto (follows OS)':t;
 el.style.background=t==='auto'?`linear-gradient(135deg,${THEMES.midnight.accent} 50%,${THEMES.paper.accent} 50%)`:THEMES[t].accent;el.onclick=()=>applyTheme(t);tdiv.appendChild(el);}
applyTheme(theme);
/* add-ons — each registered one gets a card; built generically */
function fmtLeft(s){if(s==null)return'';const h=Math.floor(s/3600),m=Math.floor(s%3600/60);
 if(s>=86400)return Math.floor(s/86400)+'d '+h%24+'h';
 return h?h+'h '+m+'m':m+'m'}
function fmtTok(n){n=n||0;return n>999999?(n/1e6).toFixed(1)+'M':n>999?(n/1e3).toFixed(0)+'K':''+n}
const CARD_RENDER={needle:(box,d)=>{
 if(d.error){box.innerHTML=`<span style="color:var(--kill)">${esc(d.error)}</span>`;return}
 if(!Array.isArray(d.providers)){box.innerHTML='<span style="color:var(--dim)">no data</span>';return}
 box.innerHTML=d.providers.filter(p=>!p.hidden).map(p=>{
  if(!p.ok)return`<div style="margin:.3rem 0"><b>${esc(p.name)}</b> <span style="color:var(--dim)">— ${esc(p.error||'unavailable')}</span></div>`;
  if(p.tally){const t=p.tally;
   const models=(t.top_models||[]).map(m=>`<div style="padding-left:1rem;color:var(--dim)">${esc(m.model)}: ${m.tokens>999999?(m.tokens/1e6).toFixed(1)+'M':m.tokens>999?(m.tokens/1e3).toFixed(0)+'K':m.tokens} tok</div>`).join('');
   return`<div style="margin:.3rem 0"><b>${esc(p.name)}</b>`+
    `<div style="padding-left:1rem;color:var(--dim)">Today ${fmtTok(t.today)} · Week ${fmtTok(t.week)} · All ${fmtTok(t.all_time)}</div>`+models+`</div>`}
  return`<div style="margin:.3rem 0"><b>${esc(p.name)}</b>${p.plan?` <span style="color:var(--dim)">(${esc(p.plan)})</span>`:''}`
   +(p.windows||[]).map(w=>{
     const now=Date.now()/1000;
     const left=w.resets_at!=null?Math.max(w.resets_at-now,0):null;
     const pct=w.used!=null?Math.max(100-Math.min(w.used,100),0):null;
     return`<div style="padding-left:1rem;color:var(--dim)">${esc(w.label)}: `
      +(pct!=null?`<b style="color:var(--fg)">${pct.toFixed(0)}% left</b>${meter(pct)}`:esc(w.detail||''))
      +(left!=null&&left>0?` · resets in ${fmtLeft(left)}`:'')+`</div>`}).join('')
   +`</div>`}).join('')
  +`<div style="color:var(--dim);font-size:.75rem;margin-top:.3rem">${d._live?'live':'cached'} `
  +(d.updated?new Date(d.updated*1000).toLocaleTimeString():'')+'</div>';},
docker:(box,d)=>{
 if(d.error){box.innerHTML=`<span style="color:var(--kill)">${esc(d.error)}</span>`;return}
 if(!d.containers||!d.containers.length){box.innerHTML='<span style="color:var(--dim)">no containers running</span>';return}
 box.innerHTML=d.containers.map(c=>`<div style="margin:.3rem 0"><b>${esc(c.Name)}</b>`
  +` <span style="color:var(--dim)">${esc(c.CPUPerc)} CPU · ${esc(c.MemUsage)}`
  +`${c.State&&c.State!=='running'?' · <span style="color:var(--kill)">'+esc(c.State)+'</span>':''}</span></div>`).join('');}};
async function loadAddon(name,live){
 const btn=document.querySelector('#addon-'+name+' button');
 if(btn){btn.disabled=true;btn.textContent=live?'…':'refresh';}
 try{const r=await fetch('/api/addon/'+name+(live?'?live=1':''));
  (CARD_RENDER[name]||((b,d)=>b.textContent=JSON.stringify(d)))(
   document.querySelector('#addon-'+name+' .card'),await r.json());}
 catch(e){document.querySelector('#addon-'+name+' .card').textContent='error: '+(e&&e.message?e.message:e)}
 if(btn){btn.disabled=false;btn.textContent='refresh';}}
for(const name of ADDONS){
 const wrap=document.createElement('div');wrap.id='addon-'+name;
 wrap.innerHTML=`<h2 style="font-size:.95rem;color:var(--accent);margin:1.6rem 0 .4rem">${name==='needle'?'AI usage':name}
  <button style="background:var(--killbg);color:var(--accent);border-color:var(--accent);font-size:.75rem;padding:.1rem .5rem">refresh</button></h2>
  <div class=card style="font-size:.85rem"></div>`;
 wrap.querySelector('button').onclick=()=>loadAddon(name,true);
 document.querySelector('#addons').appendChild(wrap);
 loadAddon(name,false);}
document.addEventListener('click',async e=>{
 const b=e.target.closest('button[data-p]');if(!b)return;
 if(!confirm('kill '+b.dataset.n+' on port '+b.dataset.p+'?'))return;
 const r=await fetch('/api/kill',{method:'POST',body:b.dataset.p});
 document.querySelector('#msg').textContent=await r.text();
 setTimeout(refresh,1500);});
/* poll only while visible: a background tab would otherwise run sudo ss
   every 5s; catch up immediately when the tab comes back */
refresh();setInterval(()=>{if(!document.hidden)refresh()},5000);
document.addEventListener('visibilitychange',()=>{if(!document.hidden)refresh()});
</script></body></html>"""

PAGE = PAGE_TMPL.replace("__ICON__", ICON_HEAD).replace("__HOST__", HOST).replace("__THEMES__", THEMES_JS)

LOGIN_TMPL = """<!DOCTYPE html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
__ICON__
<title>PinePorts — locked</title><script>__THEMES__</script><style>
:root{--bg:#111;--fg:#ddd;--line:#333;--accent:#7ec8e3;--kill:#e57373;--barbg:#222}
body{font-family:ui-monospace,Menlo,Consolas,monospace;background:var(--bg);color:var(--fg);
display:flex;align-items:center;justify-content:center;min-height:100vh}
form{display:flex;gap:.5rem}input{background:var(--barbg);color:var(--fg);border:1px solid var(--line);
border-radius:4px;padding:.5rem;font-size:1.2rem;width:8ch;text-align:center;
letter-spacing:.3em;font-family:inherit}
button{background:var(--barbg);color:var(--accent);border:1px solid var(--accent);border-radius:4px;
padding:.5rem 1rem;cursor:pointer;font-family:inherit}
#err{color:var(--kill);margin-top:.8rem;text-align:center}
</style></head><body><div>
<h1 style="font-size:1.1rem;color:var(--accent)">ports — __HOST__</h1>
<form onsubmit="return go(event)"><input id=pin type=password inputmode=numeric
maxlength=4 autofocus autocomplete=off><button>enter</button></form>
<div id=err></div></div>
<script>
async function go(e){e.preventDefault();
 const r=await fetch('/api/login',{method:'POST',body:document.getElementById('pin').value});
 if(r.ok){location.reload()}else{document.getElementById('err').textContent=await r.text()}}
</script></body></html>"""

LOGIN_PAGE = LOGIN_TMPL.replace("__ICON__", ICON_HEAD).replace("__HOST__", HOST).replace("__THEMES__", THEMES_JS)

class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype="text/html; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.end_headers()
        self.wfile.write(body.encode() if isinstance(body, str) else body)

    def do_GET(self):
        if self.path.split("?")[0] in ICON_PATHS:  # public: iOS fetches it without the cookie
            self.send_response(200)
            self.send_header("Content-Type", "image/png")
            self.send_header("Cache-Control", "max-age=86400")
            self.end_headers()
            self.wfile.write(ICON_PNG)
            return
        if not check_auth(self):
            self._send(200, LOGIN_PAGE)
            return
        if self.path == "/" or self.path.startswith("/index"):
            self._send(200, PAGE.replace("__ADDONS__", json.dumps(sorted(ADDONS))))
        elif self.path == "/api/services":
            g = gather()
            self._send(200, json.dumps(
                {"services": g, "total": sum(e["rss"] or 0 for e in g),
                 "stats": sys_stats()}),
                "application/json")
        elif self.path.startswith("/api/addon/"):
            rest = self.path[len("/api/addon/"):]
            name, _, query = rest.partition("?")
            if name not in ADDONS:
                self._send(404, json.dumps({"error": "unknown add-on"}),
                           "application/json")
                return
            ad = ADDONS[name]
            live = "live=1" in query
            cmd = [ad["cmd"]] + (ad["live"] if live else ad["cached"])
            t_cached, t_live = ad["timeout"]
            try:
                r = subprocess.run(cmd, capture_output=True, text=True,
                                   timeout=t_live if live else t_cached)
                if r.returncode != 0:
                    self._send(500, json.dumps(
                        {"error": r.stderr.strip() or "add-on failed"}),
                        "application/json")
                    return
                data = json.loads(r.stdout)
                data["_live"] = live
                self._send(200, json.dumps(data), "application/json")
            except subprocess.TimeoutExpired:
                self._send(504, json.dumps({"error": "add-on timed out"}),
                           "application/json")
            except (json.JSONDecodeError, OSError) as ex:
                self._send(500, json.dumps({"error": str(ex)}),
                           "application/json")
        else:
            self._send(404, "not found", "text/plain")

    def do_POST(self):
        if self.path == "/api/login":
            n = int(self.headers.get("Content-Length", 0))
            pin = self.rfile.read(n).decode().strip()
            res = try_login(pin)
            if res == "ok":
                tok = secrets.token_hex(32)
                SESSIONS.add(tok)
                self.send_response(200)
                self.send_header("Set-Cookie",
                                 f"ports_auth={tok}; Path=/; Max-Age=2592000; HttpOnly; SameSite=Lax")
                self.end_headers()
            elif res == "locked":
                self._send(429, "too many tries, wait a few minutes", "text/plain")
            else:
                time.sleep(1)  # slow down brute force
                self._send(403, "wrong pin", "text/plain")
            return
        if not check_auth(self):
            self._send(403, "not authorized", "text/plain")
            return
        if self.path == "/api/kill":
            n = int(self.headers.get("Content-Length", 0))
            port = self.rfile.read(n).decode().strip()
            if not port.isdigit():
                self._send(400, "bad port", "text/plain")
                return
            self._send(200, kill_port(port), "text/plain")
        else:
            self._send(404, "not found", "text/plain")

    def log_message(self, *a):
        pass

def web():
    print(f"ports web UI on http://0.0.0.0:{WEB_PORT}/")
    ThreadingHTTPServer(("0.0.0.0", WEB_PORT), Handler).serve_forever()

if __name__ == "__main__":
    if len(sys.argv) >= 2:
        if sys.argv[1] in ("-w", "--web"):
            web()
        elif sys.argv[1] == "kill" and len(sys.argv) >= 3:
            print(kill_port(sys.argv[2]))
        else:
            print(__doc__)
    else:
        print_table()
