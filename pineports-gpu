#!/usr/bin/env python3
"""pineports-gpu — GPU / VRAM readings for the PinePort web UI.

PinePort add-on contract: print JSON. Reads every NVIDIA GPU through
nvidia-smi (installed with the driver, on PATH on both Linux and
Windows). Exit non-zero (with a message on stderr) when nvidia-smi is
missing or fails, so the card shows the real error.

`--cached` and bare invocation produce the same output: nvidia-smi is a
local driver call, fast enough that cached and live are the same thing.
"""
import json
import os
import shutil
import subprocess
import sys
import time

QUERY = ("index,name,utilization.gpu,memory.used,memory.total,"
         "temperature.gpu,power.draw,power.limit,fan.speed")

# Windows driver installs put nvidia-smi on PATH (System32); older
# drivers used the NVSMI folder, which is not on PATH.
WIN_FALLBACKS = [
    r"C:\Windows\System32\nvidia-smi.exe",
    r"C:\Program Files\NVIDIA Corporation\NVSMI\nvidia-smi.exe",
]


def find_nvidia_smi():
    hit = shutil.which("nvidia-smi")
    if hit:
        return hit
    if os.name == "nt":
        for path in WIN_FALLBACKS:
            if os.path.isfile(path):
                return path
    return None


def _num(value):
    """nvidia-smi prints plain numbers with nounits, but power.draw and
    fan.speed can be '[N/A]' or '[N/A]' variants on some setups."""
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def main():
    smi = find_nvidia_smi()
    if not smi:
        print("nvidia-smi not found (NVIDIA driver not installed?)",
              file=sys.stderr)
        sys.exit(1)
    try:
        r = subprocess.run(
            [smi, f"--query-gpu={QUERY}", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=8)
    except OSError:
        print("nvidia-smi is not executable", file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print("nvidia-smi timed out", file=sys.stderr)
        sys.exit(1)
    if r.returncode != 0:
        print(r.stderr.strip() or "nvidia-smi failed", file=sys.stderr)
        sys.exit(1)
    gpus = []
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        fields = [f.strip() for f in line.split(",")]
        if len(fields) < 9:
            continue
        gpus.append({
            "index": int(_num(fields[0]) or 0),
            "name": fields[1],
            "util": _num(fields[2]),
            "mem_used": _num(fields[3]),
            "mem_total": _num(fields[4]),
            "temp": _num(fields[5]),
            "power_draw": _num(fields[6]),
            "power_limit": _num(fields[7]),
            "fan": _num(fields[8]),
        })
    print(json.dumps({"gpus": gpus, "updated": time.time()}))


if __name__ == "__main__":
    main()
